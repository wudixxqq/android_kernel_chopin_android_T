# chopin (MT6893) 内核自动编译配置
# 本文件同时被 GitHub Actions 与本地 build-ci.sh 读取

# 机型标识（用于产物命名）
KERNEL_JX=chopin

# 内核 defconfig 名称
# 可选值：chopin_user_defconfig、ares_user_defconfig
KERNEL_CONFIG=chopin_user_defconfig

# 是否默认启用 KernelSU 相关（仅影响本地脚本默认值，CI 由 workflow 输入控制）
KERNEL_KSU=yes

# AnyKernel3 打包仓库
ANYKERNEL_REPO=https://github.com/AbzRaider/AnyKernel33
ANYKERNEL_BRANCH=ares

# 工具链配置
# 支持两种格式：
#   1. git 仓库 + 分支："URL -b branch"
#   2. tar.gz 压缩包 URL
CLANG_URL="https://github.com/crdroidandroid/android_prebuilts_clang_host_linux-x86_clang-6443078 -b 10.0"

# GCC 工具链（GitHub 镜像，完整编译器）
GCC64_URL="https://github.com/KudProject/aarch64-linux-android-4.9.git -b master"
GCC32_URL="https://github.com/dandelion64-Archives/arm-linux-androideabi-4.9.git -b main"

# Telegram 通知默认关闭
ENABLE_TG=no
